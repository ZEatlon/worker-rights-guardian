{% set violation_lines = [] %}
{% for v in violations %}
{%- set line = "【" ~ v.code ~ " / " ~ violation_label(v.code) ~ "】 " ~ (v.description or '') %}
{%- if v.amount is defined and v.amount and v.amount != 0 %}
{%- set line = line ~ "(涉及金额:" ~ v.amount | format_currency(currency or 'CNY') ~ ")" %}
{%- endif %}
{%- set _ = violation_lines.append(line) %}
{%- endfor %}
